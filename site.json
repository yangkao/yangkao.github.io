      "readMinutes": 2,
      "artwork": "notes",
      "images": {
        "7b822166-4855-42c6-85c1-4f3b7fc8c5b9": {
          "alt": "",
          "caption": "",
          "url": "media/7b822166-4855-42c6-85c1-4f3b7fc8c5b9/web.webp"
        }
